# SSHer web UI. ${API_UPSTREAM} is filled in from the environment when the container starts.

# The terminal is a WebSocket on /api/terminal: pass the upgrade through, and use a
# plain keep-alive connection for everything else.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      '';
}

server {
    listen      80;
    server_name _;

    root  /usr/share/nginx/html;
    index index.html;

    gzip            on;
    gzip_types      text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # Uploads (files and docker image tarballs) can be gigabytes: no size cap, stream the
    # body straight through rather than buffering it to disk first, and allow slow links.
    client_max_body_size    0;
    proxy_request_buffering off;
    proxy_buffering         off;
    proxy_read_timeout      3600s;
    proxy_send_timeout      3600s;

    # Answered by this container alone: tells "web is up" apart from "API is up" (/api/health).
    location = /healthz {
        default_type application/json;
        return 200 '{"ok":true,"service":"ssher-web","api":"${API_UPSTREAM}"}';
    }

    location /api/ {
        proxy_pass         ${API_UPSTREAM};
        proxy_http_version 1.1;
        # The upstream's own host name (e.g. app.ssh.com.ly), not this site's: the API's
        # nginx picks its server block by Host, and an https upstream needs it as SNI too.
        proxy_set_header   Host            $proxy_host;
        proxy_ssl_server_name on;
        proxy_set_header   Upgrade         $http_upgrade;
        proxy_set_header   Connection      $connection_upgrade;
        proxy_set_header   X-Real-IP       $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
